<Window x:Class="JustSTT.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Just Speech to Text - Voice Dictation"
        Height="680" Width="860"
        MinHeight="580" MinWidth="740"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgWindow}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, sans-serif">

    <Window.Resources>
        <!-- Buttons Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BtnBg}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BtnBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar Navigation Buttons -->
        <Style x:Key="NavButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,2,0,2" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="NavBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource BgInputHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource NavActiveBg}" />
                                <Setter TargetName="NavBorder" Property="BorderBrush" Value="{DynamicResource NavActiveBorder}" />
                                <Setter TargetName="NavBorder" Property="BorderThickness" Value="1" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource BgInput}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CaretBrush" Value="#8B5CF6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="TxtBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TxtBorder" Property="BorderBrush" Value="#4F4F6E" />
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="TxtBorder" Property="BorderBrush" Value="{DynamicResource BorderFocus}" />
                                <Setter TargetName="TxtBorder" Property="Background" Value="{DynamicResource BgInputHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PasswordBox Style -->
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{DynamicResource BgInput}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CaretBrush" Value="#8B5CF6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="PwdBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PwdBorder" Property="BorderBrush" Value="#4F4F6E" />
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="PwdBorder" Property="BorderBrush" Value="{DynamicResource BorderFocus}" />
                                <Setter TargetName="PwdBorder" Property="Background" Value="{DynamicResource BgInputHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Style -->
        <ControlTemplate x:Key="DarkComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="templateRoot"
                    Background="{DynamicResource BgInput}"
                    BorderBrush="{DynamicResource BorderDefault}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="28" />
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="1"
                          Data="M 0 0 L 4 4 L 8 0 Z"
                          Fill="{DynamicResource TextSecondary}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="templateRoot" Property="Background" Value="{DynamicResource BgInputHover}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="templateRoot" Property="BorderBrush" Value="{DynamicResource BorderFocus}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                Margin="3,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource BgInputHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource NavActiveBg}" />
                                <Setter Property="Foreground" Value="{DynamicResource BorderFocus}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Background" Value="{DynamicResource BgInput}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton"
                                          Template="{StaticResource DarkComboBoxToggleButton}"
                                          Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press" />
                            <ContentPresenter Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="12,0,28,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />
                            <Popup Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid Name="DropDown"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="{DynamicResource DropdownBg}"
                                            BorderBrush="{DynamicResource BorderDefault}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="4"
                                            Margin="0,4,0,0">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.4" />
                                        </Border.Effect>
                                        <ScrollViewer SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Custom CheckBox Style with Clean Breathing Spacing -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border x:Name="BoxBorder"
                                    Grid.Column="0"
                                    Width="18" Height="18"
                                    CornerRadius="4.5"
                                    Background="{DynamicResource CheckBg}"
                                    BorderBrush="{DynamicResource CheckBorder}"
                                    BorderThickness="1.5"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center">
                                <Path x:Name="CheckMark"
                                      Data="M 3.5 9 L 7.5 13 L 14.5 5"
                                      Stroke="White"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Visibility="Collapsed"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Border>

                            <ContentPresenter Grid.Column="1"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BoxBorder" Property="Background" Value="{DynamicResource CheckActiveBg}" />
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="{DynamicResource CheckActiveBg}" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="{DynamicResource BorderFocus}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR -->
        <Border Grid.Column="0"
                Background="{DynamicResource BgSidebar}"
                BorderBrush="{DynamicResource BorderDefault}"
                BorderThickness="0,0,1,0"
                Padding="16,20,16,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- App Brand -->
                <StackPanel Grid.Row="0" Margin="4,0,0,24">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource LogoBg}" BorderBrush="{DynamicResource LogoBorder}" BorderThickness="1" Margin="0,0,10,0">
                            <TextBlock Text="🎙️" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Just STT"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Just Speech to Text"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondary}"
                               Margin="40,2,0,0" />
                </StackPanel>

                <!-- Navigation Tabs -->
                <StackPanel Grid.Row="1">
                    <RadioButton x:Name="NavHistoryRadio"
                                 Style="{StaticResource NavButtonStyle}"
                                 Content="🕒 Recent History"
                                 IsChecked="True"
                                 Checked="OnNavTabChanged" />

                    <RadioButton x:Name="NavGeminiRadio"
                                 Style="{StaticResource NavButtonStyle}"
                                 Content="🤖 AI Model &amp; API"
                                 Checked="OnNavTabChanged" />

                    <RadioButton x:Name="NavTriggersRadio"
                                 Style="{StaticResource NavButtonStyle}"
                                 Content="🖱️ Triggers (Keys/Mouse)"
                                 Checked="OnNavTabChanged" />

                    <RadioButton x:Name="NavAudioRadio"
                                 Style="{StaticResource NavButtonStyle}"
                                 Content="🎙️ Microphone &amp; Audio"
                                 Checked="OnNavTabChanged" />

                    <RadioButton x:Name="NavVocabRadio"
                                 Style="{StaticResource NavButtonStyle}"
                                 Content="📖 Vocabulary &amp; Tone"
                                 Checked="OnNavTabChanged" />

                    <RadioButton x:Name="NavPrivacyRadio"
                                 Style="{StaticResource NavButtonStyle}"
                                 Content="🛡️ Privacy &amp; Security"
                                 Checked="OnNavTabChanged" />

                    <RadioButton x:Name="NavGeneralRadio"
                                 Style="{StaticResource NavButtonStyle}"
                                 Content="⚙️ General Settings"
                                 Checked="OnNavTabChanged" />
                </StackPanel>

                <!-- Status Badge at Bottom -->
                <Border Grid.Row="2"
                        Background="{DynamicResource BgCard}"
                        BorderBrush="{DynamicResource BorderDefault}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10,8">
                    <TextBlock x:Name="SidebarStatusText"
                               Text="● Push-to-Talk Ready"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="#10B981" />
                </Border>
            </Grid>
        </Border>

        <!-- RIGHT CONTENT AREA -->
        <Grid Grid.Column="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. SECTION: RECENT HISTORY -->
            <Grid x:Name="HistorySectionGrid" Grid.Row="0" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Recent Dictations" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Text="Voice recordings &amp; transcripts stored locally according to retention settings" FontSize="12.5" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="🔄 Refresh" Click="OnRefreshHistoryClicked" />
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="RecordingsStackPanel" />
                </ScrollViewer>
            </Grid>

            <!-- 2. SECTION: GEMINI API -->
            <Grid x:Name="GeminiSectionGrid" Grid.Row="0" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="AI Model &amp; API Configuration" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,16" />

                        <!-- Model Selection Card -->
                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Transcription Engine / Model" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4" />
                                <TextBlock Text="Choose between high-accuracy cloud transcription or real-time streaming." FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10" />

                                <ComboBox x:Name="ModelComboBox">
                                    <ComboBoxItem Content="gemini-3.5-transcribe" IsSelected="True" />
                                    <ComboBoxItem Content="gemini-3.5-transcribe-live" />
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <!-- API Key Card -->
                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="AI Studio API Key" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4" />
                                <TextBlock Text="Your API key is stored securely using Windows DPAPI encryption on this device." FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10" />

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox x:Name="ApiKeyBox" Grid.Column="0" Margin="0,0,10,0" />
                                    <Button x:Name="TestKeyButton" Grid.Column="1" Content="⚡ Test Connection" Click="OnTestKeyClicked" />
                                </Grid>

                                <TextBlock x:Name="KeyTestStatusText" Text="" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" CornerRadius="10" Padding="12">
                            <TextBlock Text="🔑 Need an API key? Get one free at https://aistudio.google.com/apikey." FontSize="11.5" Foreground="{DynamicResource TextSecondary}" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 3. SECTION: TRIGGERS -->
            <Grid x:Name="TriggersSectionGrid" Grid.Row="0" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Dictation Triggers" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,16" />

                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Active Triggers (Keyboard &amp; Mouse)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4" />
                                <TextBlock Text="Hold any configured key or mouse button to talk. Release to transcribe &amp; type at cursor." FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10" />

                                <Border Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,0,0,12">
                                    <ListBox x:Name="TriggersListBox" Background="Transparent" Foreground="{DynamicResource TextPrimary}" BorderThickness="0" Height="110" SelectionMode="Single" />
                                </Border>

                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button x:Name="RecordTriggerButton" Content="➕ Add Trigger (Press Key/Mouse)" Click="OnRecordTriggerClicked" Background="{DynamicResource PrimaryBtnBg}" BorderBrush="{DynamicResource PrimaryBtnBorder}" Foreground="{DynamicResource PrimaryBtnFg}" Margin="0,0,8,6" />
                                    <Button x:Name="RemoveTriggerButton" Content="➖ Remove Selected" Click="OnRemoveTriggerClicked" Margin="0,0,8,6" />
                                    <Button x:Name="ResetDefaultTriggersButton" Content="↺ Reset (Right Ctrl + Mouse 5)" Click="OnResetDefaultTriggersClicked" Margin="0,0,0,6" />
                                </WrapPanel>

                                <TextBlock x:Name="TriggerCaptureStatusText" Text="" FontSize="12" FontWeight="Bold" Foreground="#FBBF24" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" CornerRadius="12" Padding="16">
                            <StackPanel>
                                <CheckBox x:Name="HandsFreeCheckBox" Content="Enable Hands-Free mode (Hold trigger + Space, or double-tap trigger)" Margin="0,0,0,10" IsChecked="True" />
                                <CheckBox x:Name="SoundFeedbackCheckBox" Content="Play subtle sound effects on recording start/stop" IsChecked="True" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 4. SECTION: AUDIO -->
            <Grid x:Name="AudioSectionGrid" Grid.Row="0" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Microphone &amp; Audio" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,16" />

                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" CornerRadius="12" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Input Device" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4" />
                                <ComboBox x:Name="MicrophoneComboBox" Margin="0,0,0,16" />

                                <TextBlock Text="Live Microphone Test" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ProgressBar x:Name="MicTestProgressBar" Grid.Column="0" Height="14" Margin="0,0,12,0" Minimum="0" Maximum="1" Value="0" Foreground="#10B981" Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" />
                                    <Button x:Name="TestMicButton" Grid.Column="1" Content="🎤 Test Mic" Click="OnTestMicClicked" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 5. SECTION: VOCABULARY & TONE -->
            <Grid x:Name="VocabSectionGrid" Grid.Row="0" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Vocabulary &amp; Tone" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,16" />

                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Tone Preset" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4" />
                                <ComboBox x:Name="TonePresetComboBox">
                                    <ComboBoxItem Content="Natural Clean" IsSelected="True" />
                                    <ComboBoxItem Content="Casual Chat" />
                                    <ComboBoxItem Content="Formal Email" />
                                    <ComboBoxItem Content="Code &amp; Technical" />
                                    <ComboBoxItem Content="Direct" />
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" CornerRadius="12" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Custom Vocabulary &amp; Jargon" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4" />
                                <TextBlock Text="Comma-separated names, technical terms, or product names (e.g. JustSTT, Kubernetes, TypeScript)." FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10" />
                                <TextBox x:Name="CustomVocabularyTextBox" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14" />

                                <TextBlock Text="Additional System Instructions (Optional)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4" />
                                <TextBox x:Name="CustomPromptTextBox" Height="55" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 6. SECTION: PRIVACY & SECURITY -->
            <Grid x:Name="PrivacySectionGrid" Grid.Row="0" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Privacy &amp; Security" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,16" />

                        <!-- In-Memory Storage Mode Card -->
                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="⚡ Storage Mode (In-Memory vs Disk)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4" />
                                <TextBlock Text="Keep audio recordings and transcription history in RAM only (0 bytes on disk) for maximum privacy, or save rolling history to disk." FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10" />

                                <CheckBox x:Name="InMemoryOnlyCheckBox" Content="In-Memory Storage Only (Zero disk footprint, auto-purged on exit)" IsChecked="True" />
                            </StackPanel>
                        </Border>

                        <!-- Password Protection Card -->
                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="🔒 Password Field Protection" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4" />
                                <TextBlock Text="Automatically suppresses dictation and microphone recording whenever your active cursor is inside a password field (browsers, login dialogs, apps)." FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10" />

                                <CheckBox x:Name="SuppressPasswordCheckBox" Content="Block dictation automatically in password fields" IsChecked="True" />
                            </StackPanel>
                        </Border>

                        <!-- The Promise Card -->
                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="🛡️ The Privacy Promise (Zero Telemetry)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8" />
                                <TextBlock Text="• Direct HTTPS/WSS: Audio travels directly to the API endpoint without intermediate servers." TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                                <TextBlock Text="• Windows DPAPI: Your API key is encrypted locally using Windows DPAPI, bound to your Windows account." TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                                <TextBlock Text="• No Analytics: Zero telemetry, zero usage tracking, and no screen capture." TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                                <TextBlock Text="• Local Rolling Storage: Transcripts and audio are stored locally according to your configured retention limit." TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" />
                            </StackPanel>
                        </Border>

                        <!-- Purge Data Card -->
                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" CornerRadius="12" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="Purge Local Data" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4" />
                                    <TextBlock Text="Delete all stored local voice recordings and transcription history immediately." TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="🗑️ Clear All History Now" Click="OnClearAllHistoryClicked" Background="{DynamicResource PurgeBtnBg}" BorderBrush="{DynamicResource PurgeBtnBorder}" Foreground="{DynamicResource PurgeBtnFg}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 7. SECTION: GENERAL -->
            <Grid x:Name="GeneralSectionGrid" Grid.Row="0" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="General Settings" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,16" />

                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Appearance / Theme Mode" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4" />
                                <TextBlock Text="Choose between Dark mode, Light mode, or follow your Windows system theme." FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10" />

                                <ComboBox x:Name="ThemeModeComboBox">
                                    <ComboBoxItem Content="System (Follow Windows theme)" IsSelected="True" />
                                    <ComboBoxItem Content="Dark" />
                                    <ComboBoxItem Content="Light" />
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Recent Recordings Retention Limit" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4" />
                                <TextBlock Text="How many recent voice recordings and transcripts to keep locally (default is 3)." FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10" />

                                <ComboBox x:Name="HistoryLimitComboBox">
                                    <ComboBoxItem Content="3 recordings (Default)" IsSelected="True" />
                                    <ComboBoxItem Content="5 recordings" />
                                    <ComboBoxItem Content="10 recordings" />
                                    <ComboBoxItem Content="20 recordings" />
                                    <ComboBoxItem Content="50 recordings" />
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" CornerRadius="12" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Text Insertion Method" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4" />
                                <ComboBox x:Name="InsertionMethodComboBox" Margin="0,0,0,16">
                                    <ComboBoxItem Content="Auto (Smart Select)" IsSelected="True" />
                                    <ComboBoxItem Content="Clipboard (Instant Paste with Ctrl+V)" />
                                    <ComboBoxItem Content="SendInput (Simulated Unicode Keystrokes)" />
                                </ComboBox>

                                <CheckBox x:Name="StartWithWindowsCheckBox" Content="Start Just STT automatically when Windows boots" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- FOOTER SAVE BUTTON -->
            <Grid Grid.Row="1" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="SaveStatusNoticeText"
                           Grid.Column="0"
                           Text=""
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           Foreground="#10B981"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left" />

                <Button x:Name="SaveButton"
                        Grid.Column="1"
                        Content="💾 Save &amp; Apply Changes"
                        Click="OnSaveClicked"
                        Background="{DynamicResource PrimaryBtnBg}"
                        BorderBrush="{DynamicResource PrimaryBtnBorder}"
                        Foreground="{DynamicResource PrimaryBtnFg}"
                        Padding="22,10"
                        FontSize="13"
                        FontWeight="Bold" />
            </Grid>
        </Grid>
    </Grid>
</Window>
