<Window x:Class="JustSTT.Views.OverlayPillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:JustSTT.Controls"
        mc:Ignorable="d"
        Title="Just Speech to Text HUD"
        Height="46"
        MinWidth="168"
        MaxWidth="260"
        SizeToContent="Width"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <DropShadowEffect x:Key="PillShadow" 
                          Color="#000000" 
                          BlurRadius="16" 
                          ShadowDepth="2" 
                          Opacity="0.25" />
    </Window.Resources>

    <Grid Margin="4,3,4,3">
        <!-- Compact Mini Monochrome Bottom Floating Pill -->
        <Border x:Name="PillBorder"
                CornerRadius="16"
                Background="{DynamicResource OverlayBg}"
                BorderBrush="{DynamicResource OverlayBorder}"
                BorderThickness="1"
                Effect="{StaticResource PillShadow}"
                Padding="10,0,10,0"
                Cursor="Hand"
                MouseLeftButtonDown="OnPillMouseLeftButtonDown">

            <Grid Height="32">
                <!-- 1. RECORDING STATE -->
                <Grid x:Name="RecordingStateGrid" Visibility="Visible">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Icon Emblem -->
                    <Border Grid.Column="0"
                            Width="20" Height="20"
                            CornerRadius="10"
                            Background="{DynamicResource OverlayCapsuleBg}"
                            BorderBrush="{DynamicResource OverlayCapsuleBorder}"
                            BorderThickness="1"
                            VerticalAlignment="Center"
                            Margin="0,0,6,0">
                        <TextBlock Text="🎙️"
                                   FontSize="10"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <!-- Dynamic Monochrome Waveform -->
                    <controls:WaveformVisualizer x:Name="WaveVisualizer"
                                                 Grid.Column="1"
                                                 Width="48" Height="16"
                                                 BarBrush="{DynamicResource OverlayWaveform}"
                                                 VerticalAlignment="Center"
                                                 HorizontalAlignment="Center"
                                                 Margin="0,0,6,0" />

                    <!-- Capsule Timer -->
                    <Border Grid.Column="2"
                            Background="{DynamicResource OverlayCapsuleBg}"
                            BorderBrush="{DynamicResource OverlayCapsuleBorder}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="5,1.5"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="RecordingTimerText"
                                   Text="0:00"
                                   Foreground="{DynamicResource OverlayText}"
                                   FontSize="10.5"
                                   FontFamily="Consolas, Segoe UI"
                                   FontWeight="SemiBold" />
                    </Border>
                </Grid>

                <!-- 2. PROCESSING STATE -->
                <Grid x:Name="TranscribingStateGrid" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar IsIndeterminate="True"
                                     Width="12" Height="12"
                                     Margin="0,0,6,0"
                                     VerticalAlignment="Center"
                                     Foreground="{DynamicResource OverlayText}" />
                        <TextBlock Text="Transcribing..."
                                   Foreground="{DynamicResource OverlayText}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- 3. SUCCESS STATE -->
                <Grid x:Name="SuccessStateGrid" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="17" Height="17"
                                CornerRadius="8.5"
                                Background="#2A10B981"
                                BorderBrush="#4D10B981"
                                BorderThickness="1"
                                Margin="0,0,7,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="✓"
                                       Foreground="#10B981"
                                       FontWeight="Bold"
                                       FontSize="9.5"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="0,-0.5,0,0" />
                        </Border>
                        <TextBlock x:Name="SuccessPreviewText"
                                   Text="Inserted"
                                   Foreground="{DynamicResource OverlayText}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- 4. ERROR / NOTICE STATE -->
                <Grid x:Name="ErrorStateGrid" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="17" Height="17"
                                CornerRadius="8.5"
                                Background="#2AF43F5E"
                                BorderBrush="#4DF43F5E"
                                BorderThickness="1"
                                Margin="0,0,7,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="✕"
                                       Foreground="#F43F5E"
                                       FontWeight="Bold"
                                       FontSize="9.5"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="0,-0.5,0,0" />
                        </Border>
                        <TextBlock x:Name="ErrorDetailText"
                                   Text="No speech detected"
                                   Foreground="{DynamicResource OverlayText}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="180" />
                    </StackPanel>
                </Grid>

                <!-- 5. STARTUP WELCOME POPUP STATE -->
                <Grid x:Name="WelcomeStateGrid" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="20" Height="20"
                                CornerRadius="5"
                                Background="{DynamicResource OverlayCapsuleBg}"
                                BorderBrush="{DynamicResource OverlayCapsuleBorder}"
                                BorderThickness="1"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="🎙️"
                                       FontSize="10.5"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Just STT"
                                   Foreground="{DynamicResource OverlayText}"
                                   FontSize="11.5"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,5,0" />
                        <Border Background="#1A10B981"
                                BorderBrush="#3310B981"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="4,1"
                                VerticalAlignment="Center">
                            <TextBlock Text="Ready"
                                       Foreground="#10B981"
                                       FontSize="9.5"
                                       FontWeight="Bold" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
